diff -ru a/libavformat/mux.c b/libavformat/mux.c
--- a/libavformat/mux.c
+++ b/libavformat/mux.c
@@ -591,23 +591,10 @@
         pkt->dts = st->internal->pts_buffer[0];
     }
 
-    if (st->cur_dts && st->cur_dts != AV_NOPTS_VALUE &&
